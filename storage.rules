rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isImage() { return request.resource.contentType.matches('image/.*') && request.resource.size < 5 * 1024 * 1024; }
    function isAdmin() {
      return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Client problem photos
    match /requests/{uid}/{file} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid && isImage();
    }
    // Worker ID proof & work samples
    match /workers/{uid}/{file} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn() && request.auth.uid == uid && isImage();
    }
    // Worker job-completion photos
    match /jobs/{requestId}/{uid}/{file} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid && isImage();
    }
    // Blog images
    match /blog/{file} {
      allow read: if true;
      allow write: if isAdmin() && isImage();
    }
  }
}
