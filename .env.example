# ---------- Firebase (client) : Firebase console > Project settings > Your apps > Web app ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Firebase Admin (server) : Project settings > Service accounts > Generate new private key ----------
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
# Keep the quotes and the \n characters exactly as in the JSON file
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# ---------- Owner / admin ----------
# Comma separated. Anyone who registers with one of these emails becomes ADMIN (full access).
ADMIN_EMAILS=owner@example.com

# ---------- Razorpay : dashboard.razorpay.com > Settings > API keys (use test keys first) ----------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# ---------- Email notifications to the company (optional) ----------
# Everything is always visible in the Admin panel. If these are filled, an email is ALSO sent.
# Gmail: turn on 2-step verification, then create an "App password".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
COMPANY_NOTIFY_EMAIL=

# Public site URL (used in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
